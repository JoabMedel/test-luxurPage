---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Landing base">
  <section class="flex min-h-screen items-center justify-center px-6">
    <h1 data-reveal class="text-center text-6xl font-bold tracking-tight md:text-8xl">
      Landing <span class="text-purple-400">base</span>
    </h1>
  </section>

  <section class="flex min-h-screen items-center justify-center px-6">
    <p data-reveal class="max-w-xl text-center text-2xl text-neutral-300">
      Astro + Tailwind + GSAP + Lenis funcionando.
    </p>
  </section>
</Layout>
