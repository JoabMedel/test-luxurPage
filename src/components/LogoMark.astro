---
/**
 * The brand logotype "RAUH-Welt" as outlined paths (see tools/build-logo.mjs).
 * Same geometry feeds the WebGL ink mask in src/scripts/fluid.ts.
 */
import { LOGO } from '../lib/logo';

interface Props {
  id?: string;
  class?: string;
  /** accessible name; pass "" when the surrounding element already names it */
  label?: string;
  /** wrap each glyph in its own group (+ hit area) for per-letter animation */
  split?: boolean;
}

const { id, class: className = '', label = 'RAUH-Welt', split = false } = Astro.props;
---

<svg
  id={id}
  class:list={['logomark', className]}
  viewBox={`0 0 ${LOGO.width} ${LOGO.height}`}
  role={label ? 'img' : undefined}
  aria-label={label || undefined}
  aria-hidden={label ? undefined : 'true'}
>
  {
    split
      ? LOGO.glyphs.map((g, i) => (
          <g class="wm-l" data-i={i} data-char={g.char}>
            <rect class="wm-hit" x={g.x} y="0" width={g.w} height={LOGO.height} fill="transparent" />
            <g class="wm-l-inner">
              <path d={g.d} />
            </g>
          </g>
        ))
      : LOGO.glyphs.map((g) => <path d={g.d} data-char={g.char} />)
  }
</svg>
