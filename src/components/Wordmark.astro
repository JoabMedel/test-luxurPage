---
import { layout, CAP } from '../lib/wordmark';

interface Props {
  text?: string;
  gap?: number;
  class?: string;
  label?: string;
  id?: string;
}

const { text = 'RAUH-WELT', gap, class: className = '', label = 'RAUH-WELT', id } = Astro.props;
const { glyphs, width } = layout(text, gap);
---

<svg
  id={id}
  class:list={['wordmark', className]}
  viewBox={`0 0 ${width} ${CAP}`}
  role="img"
  aria-label={label}
  data-width={width}
>
  {
    glyphs.map((g, i) => (
      <g class="wm-l" data-i={i} data-char={g.char} transform={`translate(${g.x} 0)`}>
        <rect class="wm-hit" x="0" y="0" width={g.width} height={CAP} fill="transparent" />
        <g class="wm-l-inner">
          <path d={g.d} fill-rule="evenodd" />
        </g>
      </g>
    ))
  }
</svg>
